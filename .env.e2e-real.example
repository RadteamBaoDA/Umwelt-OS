# Real-model chat e2e (opt-in). Gitignored: never commit this file. Revoke the key after testing.
# Used only by tests/e2e/chat-real-model.spec.ts; the spec is skipped while E2E_REAL_API_KEY is empty.
# The key is sent to the disposable test stack's settings API (stored encrypted there) and the stack is
# destroyed after the run; it is never written to the repository or to the developer's real .env.

# OpenAI-compatible base URL, including the version path. Must be https (public cloud endpoint).
# Examples: https://api.openai.com/v1 | https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1
E2E_REAL_BASE_URL=

# API key for that endpoint.
E2E_REAL_API_KEY=

# Model id as the endpoint names it, e.g. gpt-4o-mini | deepseek/deepseek-r1 | qwen/qwq-32b
E2E_REAL_MODEL=

# Optional: true if the model streams reasoning (reasoning_content / reasoning / <think>), so the spec
# asserts the "Thinking" block. Leave false for models that do not expose reasoning.
E2E_REAL_EXPECT_REASONING=false

# Optional: true if the model supports tool calling, so the spec asserts a generative-UI widget.
E2E_REAL_EXPECT_TOOLS=true

# Optional: low | medium | high. Stored as the chat role's reasoning effort, so request-gated models
# (that only stream reasoning when asked) show the "Thinking" block. Leave empty to send nothing.
E2E_REAL_REASONING_EFFORT=

# Keyed data-provider live e2e (opt-in, used by tests/e2e/sources-wizard.spec.ts and dashboard-datasources.spec.ts).
# A non-empty key switches that provider from "dummy key must fail cleanly" to "live fetch must return records"
# (and, in dashboard-datasources, adds a gadget). Keys go only to the disposable stack; revoke them afterwards.
# Free signup: https://fredaccount.stlouisfed.org/apikeys
E2E_KEY_FRED=
# Free signup: https://finnhub.io/register
E2E_KEY_FINNHUB_NEWS=
# Free signup: https://newsapi.org/register
E2E_KEY_NEWSAPI=
# Free signup: https://home.openweathermap.org/api_keys (a new key can take up to 2h to activate)
E2E_KEY_OPENWEATHERMAP=
# Free signup: https://explore.openaq.org/register
E2E_KEY_OPENAQ=
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/
E2E_KEY_NASA_FIRMS=
# Free signup: https://www.alphavantage.co/support/#api-key (optional: IBM works with any key)
E2E_KEY_ALPHA_VANTAGE=
