    "vulnStatus": "Deferred",
    "cveTags": [],
    "descriptions": [
     {
      "lang": "en",
      "value": "The routes that provide consent history and statistics data did not check whether the backend user had access to the module or to the requested page. Any authenticated backend user, regardless of permissions, could therefore retrieve consent data of any site in the installation."
     }
    ],
