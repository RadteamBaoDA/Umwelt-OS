# dev/test only; anything else enforces production config checks and disables /docs.
# development: local only. Accepts plain http, non-Secure cookies and the placeholder secrets below, and serves /docs.
# Leave unset (auto) once secrets are real (`make setup`): local/LAN PUBLIC_ORIGIN -> http allowed, public domain -> production.
# Set production on a server to enforce strict checks regardless of PUBLIC_ORIGIN. Never run development on a public host.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000
# Public domain (production): PUBLIC_ORIGIN must be https://your.host and SECURE_COOKIES=true or the API refuses to start.
# Local/LAN (localhost, 192.168.x.x, 10.x.x.x): plain http and SECURE_COOKIES=false are fine.
SECURE_COOKIES=false
SETUP_TOKEN=replace-with-a-random-local-secret
CSRF_SIGNING_SECRET=replace-with-a-different-random-local-secret
SESSION_LIFETIME_HOURS=24
# Keep disabled until W4 scope review and V1 security validation are complete.
MULTI_WORKSPACE_ENABLED=false
# Phone prompt picker via QR (anonymous, LAN-reachable phone routes). Keep false unless used.
PICK_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# App ID and webhook secret are set from the GitHub App's manual configuration.
GITHUB_APP_ID=
GITHUB_APP_WEBHOOK_SECRET=
# Increment when rotating the receiver secret; digests use this replay namespace.
GITHUB_WEBHOOK_RECEIVER_REVISION=1
# Must exactly match the registered GitHub App OAuth callback URL.
GITHUB_APP_CALLBACK_URL=
POSTGRES_DB=bbd
POSTGRES_USER=bbd
POSTGRES_PASSWORD=replace-with-a-third-random-local-secret
# The password in DATABASE_URL must equal POSTGRES_PASSWORD. `make setup` (scripts/ensure_env.py) generates a consistent set.
DATABASE_URL=postgresql+asyncpg://bbd:replace-with-a-third-random-local-secret@postgres:5432/bbd
# REDISCLI_AUTH is the Redis password (container requirepass + redis-cli); REDIS_URL must carry the same password.
# Required: the API/workers refuse to start without it unless ENVIRONMENT=development|test.
REDISCLI_AUTH=replace-with-a-redis-password
REDIS_URL=redis://:replace-with-a-redis-password@redis:6379/0
# Optional bounds (defaults shown): DB_POOL_SIZE=10 DB_MAX_OVERFLOW=10 DB_STATEMENT_TIMEOUT_MS=60000
# DB_IDLE_TX_TIMEOUT_MS=240000 MAX_REQUEST_BODY_BYTES=5242880 PARSED_TEXT_MAX_CHARS=10485760
# API process count (image default 2 for 2 vCPU / 8 GiB). Values above 1 require CSRF_SIGNING_SECRET.
# Set it here, never via `uvicorn --workers`. Connections: WEB_CONCURRENCY x (DB_POOL_SIZE+DB_MAX_OVERFLOW) + 37 + 5 <= 100 (+ up to 6 agent checkpoint connections).
# WEB_CONCURRENCY=2
# AUTH_TRUST_FORWARDED_FOR=false  (true only behind a proxy that overwrites X-Forwarded-For; see docs/deployment.md)
# Optional Neo4j graph (compose profile "graph" in docker-compose.base.yml); stays disabled until acceptance.
# Native dev: GRAPH_HOST=localhost. Neo4j Community has a single database, so keep GRAPH_DATABASE=neo4j.
GRAPH_ENABLED=false
GRAPH_HOST=graph
GRAPH_PORT=7687
GRAPH_USERNAME=neo4j
GRAPH_PASSWORD=replace-with-a-dedicated-graph-password
GRAPH_DATABASE=neo4j
# Read by the neo4j container itself; must be <GRAPH_USERNAME>/<GRAPH_PASSWORD>.
NEO4J_AUTH=neo4j/replace-with-a-dedicated-graph-password
NEO4J_server_memory_heap_initial__size=512m
NEO4J_server_memory_heap_max__size=1g
NEO4J_server_memory_pagecache_size=256m
NEO4J_db_transaction_timeout=5s
# Set to the actual configured embedding model output size before graph inference.
# GRAPH_EMBEDDING_DIMENSIONS=1536
DATA_DIR=/data
# Native RSS/API collection needs none of the n8n/browser values below.
# Browser token: only needed for browser collection (docker-compose.browser.yml).
BROWSER_SHARED_TOKEN=replace-with-a-random-browser-service-secret
# n8n is optional. Keep N8N_ENCRYPTION_KEY persistent: changing it makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-different-random-n8n-secret
N8N_PORT=5678
# Only when n8n is reachable via a hostname (never publish port 5678 directly):
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_SERVICE_URL=http://n8n:5678
# N8N_API_KEY is created in the n8n UI (Settings > n8n API), not generated randomly.
N8N_API_KEY=
# Needed only to store provider credentials (API keys, tokens); Fernet url-safe base64 key.
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-url-safe-base64-key
N8N_WEBHOOK_TOKEN=replace-with-a-random-manual-trigger-secret
# Set false to stop the durable collection scheduler dispatching due sources.
COLLECTOR_SCHEDULER_ENABLED=true
UPLOAD_MAX_BYTES=26214400
PARSER_TIMEOUT_SECONDS=120
CHAT_INPUT_REQUEST_TTL_SECONDS=900
DOCX_EXPANDED_MAX_BYTES=104857600
PDF_PAGE_MAX=500
STORAGE_ORPHAN_GRACE_SECONDS=3600
WEB_PORT=3000
# Reverse proxy overlay (docker-compose.proxy.yml): public hostname Caddy obtains a certificate for.
# PUBLIC_HOST=umwelt.example.com
# Global concurrent model calls across api, worker and chat-worker (a chat stream holds one for its whole answer).
MODEL_GATEWAY_SLOTS=24
# Optional Langfuse Cloud/self-hosted HTTPS export. Off until both flags are explicitly enabled.
LANGFUSE_ENABLED=false
TELEMETRY_EGRESS_APPROVED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Required to store any provider API key. Generate once and keep stable across restarts:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_ENCRYPTION_KEY=
# Exact endpoint hosts (or host:port pairs) authorized for model providers and web search.
# Local providers (Ollama / LM Studio) must be listed here, e.g.
#   ["localhost:11434","localhost:1234"]   (API on the host) or
#   ["host.docker.internal:11434"]         (API in Docker reaching a host service)
AI_ALLOWED_ENDPOINT_HOSTS=[]
# Web search needs api.tavily.com / api.search.brave.com listed above, or saving the provider returns 422.
# Per-owner chat web searches per UTC day (0 disables).
WEB_SEARCH_DAILY_LIMIT=50
# Explicitly ALLOWS these (typically private) CIDRs for web search egress, in addition to public addresses.
# Test compose only; leave empty in production. Ranges shorter than /8 (IPv4) or /16 (IPv6), including
# 0.0.0.0/0 and ::/0, are rejected at startup. Web search endpoints must be https.
WEB_SEARCH_ALLOWED_CIDRS=[]
# Approve every resolved IPv4/IPv6 address; include private CIDRs for self-hosted gateways.
# Both lists are required for network access. Empty CIDRs deny all gateway connections.
# Local examples: ["127.0.0.1/32"] for localhost; for host.docker.internal use the address it resolves to
# (Docker Desktop commonly 192.168.65.254/32, or your docker bridge gateway such as 172.17.0.1/32).
AI_ALLOWED_ENDPOINT_CIDRS=[]
# Cloud providers (OpenAI, OpenRouter, Groq, Gemini, Anthropic...): true lets https public hostnames through
# without listing each host/CIDR. Private ranges still need the allowlists above. Default false.
AI_ALLOW_PUBLIC_PROVIDERS=false
# MCP deployment exceptions are separate from model-gateway/web-search policy.
# JSON exact origin -> private/loopback CIDRs; empty means no private or HTTP exception.
# Example: {"http://127.0.0.1:8080":["127.0.0.1/32"]}
# HTTP exceptions are credential-free; use HTTPS for bearer-authenticated providers.
MCP_ALLOWED_ENDPOINT_CIDRS={}
MCP_STDIO_PROFILE_MANIFEST=
# Widget MCP server at /mcp/ (docs/mcp-widgets.md). Off by default; enabling requires a long random bearer token.
MCP_WIDGETS_ENABLED=false
MCP_WIDGETS_TOKEN=
# Exact origin of the page that embeds assembled documents; empty falls back to PUBLIC_ORIGIN.
MCP_WIDGETS_PARENT_ORIGIN=
# Empty by default. Each deployment alias fixes one HTTPS URL and private destination CIDRs.
WEBHOOK_PROFILES={}
APPROVAL_EXPIRY_HOURS=24
