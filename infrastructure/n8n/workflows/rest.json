    {"parameters":{"jsCode":"const state=$items('Validate source and load cursor')[0].json; const fence={source_generation:state.source_generation,connector_revision:state.connector_revision,backend_revision:__BBD_BACKEND_REVISION__}; const c=state.configuration; const value=$json; const rows=c.items_path.split('.').reduce((current,key)=>current?.[key],value); if(!Array.isArray(rows)) throw new Error('REST items_path did not resolve to an array'); const floor=state.catch_up_since?Date.parse(state.catch_up_since):0; const mapped=rows.map(row=>({row,id:c.id_field?.split('.').reduce((v,k)=>v?.[k],row),title:c.title_field?.split('.').reduce((v,k)=>v?.[k],row),time:c.updated_field?.split('.').reduce((v,k)=>v?.[k],row)})).filter(x=>x.id!==undefined).map(x=>{const parsed=x.time===undefined||x.time===null||x.time===''?NaN:Date.parse(x.time); return {...x,validTime:Number.isFinite(parsed),parsedTime:parsed};}).filter(x=>!x.validTime||!floor||x.parsedTime>=floor).slice(0,500); const records=mapped.map(x=>({provider_id:String(x.id),content:String(c.content_field?.split('.').reduce((v,k)=>v?.[k],x.row)??x.title??''),observed_at:new Date().toISOString(),version:x.validTime?String(x.time):null,metadata:{title:typeof x.title==='string'?x.title.slice(0,500):null,published_at:null}})); if(!records.length)return [{json:{status:'no_changes',...fence}}]; const validTimes=mapped.filter(x=>x.validTime).map(x=>x.parsedTime); return [{json:{...fence,cursor_before:state.cursor_before,cursor_after:validTimes.length?new Date(Math.max(...validTimes)).toISOString():state.cursor_before,records}}];"},"id":"d65dcdcb-b71c-43de-b9a2-835048298994","name":"Map REST records and overlap","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0]},
