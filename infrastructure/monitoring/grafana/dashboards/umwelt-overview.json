{
  "uid": "umwelt-overview",
  "title": "Umwelt-OS overview",
  "tags": [
    "umwelt-os"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(umwelt_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(umwelt_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(umwelt_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(umwelt_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(umwelt_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(umwelt_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(umwelt_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "arq queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_arq_queue_depth",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "arq oldest job age",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_arq_queue_oldest_job_age_seconds",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_outbox_pending_count",
          "legendFormat": "pending",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox lag (oldest pending)",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_outbox_oldest_pending_age_seconds",
          "legendFormat": "lag",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Background job outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, outcome) (rate(umwelt_jobs_total[5m]))",
          "legendFormat": "{{job}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cron job duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(umwelt_cron_job_duration_seconds_bucket[10m])))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cron seconds since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - umwelt_cron_job_last_success_timestamp_seconds",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cron failures (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (increase(umwelt_cron_job_failures_total[15m]))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "DB pool checked out vs max",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_db_pool_checked_out",
          "legendFormat": "{{process}} #{{pool}} checked out",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "umwelt_db_pool_max_connections",
          "legendFormat": "{{process}} #{{pool}} max",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DB pool overflow",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "umwelt_db_pool_overflow",
          "legendFormat": "{{process}} #{{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Model breaker open (1 = open)",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(umwelt_model_breaker_open_until_timestamp_seconds > bool time(), 1)",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Event-loop lag (max 1m)",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(umwelt_event_loop_lag_seconds[1m])",
          "legendFormat": "{{process}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Chat time to first token p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(umwelt_chat_time_to_first_token_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(umwelt_chat_time_to_first_token_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Ingestion stages",
      "datasource": {
        "type": "prometheus",
        "uid": "umwelt-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, outcome) (rate(umwelt_ingestion_stage_total[10m]))",
          "legendFormat": "{{stage}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "umwelt-prometheus"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}